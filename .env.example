# Railway Port (automatically set, but can override locally)
# PORT=3000

# Anthropic API Key (required for AI-powered fix recommendations)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI Model (optional, defaults to claude-sonnet-4-5)
AI_MODEL=claude-sonnet-4-5

# Admin Dashboard — secret password for /admin access
ADMIN_PASSWORD=your_admin_password_here

# Lemon Squeezy — checkout URL for paid PDF downloads
# After payment, LS redirects to /success?token=SESSION_TOKEN automatically
LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-product-id

